<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="Repository" value="__RUN_ROOT__\feeds\repository" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="Repository">
      <package pattern="Probe.Exact" />
      <package pattern="Probe.Prefix.*" />
    </packageSource>
    <packageSource key="User">
      <package pattern="*" />
      <package pattern="Probe.Duplicate" />
    </packageSource>
    <packageSource key="Machine">
      <package pattern="Probe.Duplicate" />
    </packageSource>
  </packageSourceMapping>
</configuration>
