<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="ClearRepository" value="__RUN_ROOT__\feeds\clear" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="ClearRepository">
      <package pattern="Probe.Clear" />
    </packageSource>
  </packageSourceMapping>
</configuration>
